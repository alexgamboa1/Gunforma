.env*
.env.secrets
node_modules/
.DS_Store

# Local Netlify folder
.netlify

# PII — real builder emails, never commit. Globs, not exact filenames:
# builders.real.json was created alongside builders.json and was NOT
# covered, so a `git add -A` picked it straight up. Every rule here is a
# glob for that reason — a sibling, a .bak or a dated copy is the normal way
# these files get made, and an exact filename protects none of them.
scripts/builders*.json
scripts/seed-emails*
scripts/seed-state*

# Claude Code local scratch state
.claude/

# Draft blog mockups — kept locally, not for public tracking
holosun-507c-vs-trijicon-rmr-comparison.html
holosun-507c-x2-review.html

# Cloudflare wrangler local state — pins an account id, not for tracking
.wrangler/

# Supabase CLI local state — rewritten on every `supabase functions deploy`
# and every link, so it shows up as spurious diffs. Contents are the linked
# project ref and the versions of the managed services; no credentials.
supabase/.temp/
